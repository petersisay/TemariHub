# TemariHub — Environment Variables Template (Server)
# Copy this file to .env at the repository root (or within server/).
# NEVER commit real .env files to version control.

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Frontend Application URL (for CORS origins and cookie domain security)
CLIENT_URL=http://localhost:5173

# Database Configuration
# NOTE: mongodb-memory-server is strictly used for automated integration tests.
# For local persistent development or production, provide a standard MongoDB connection string:
# Local MongoDB: mongodb://localhost:27017/temarihub
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/temarihub?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/temarihub

# Server-Side Session Configuration
# CRITICAL: In production, SESSION_SECRET must be explicitly set and >= 32 characters.
# The server will FAIL FAST on startup in production if SESSION_SECRET is missing, shorter
# than 32 characters, or left as a development default/placeholder.
#
# Generate a cryptographically secure 256-bit (32-byte) hex string using one of the following:
#   Using OpenSSL:
#     openssl rand -hex 32
#   Using Node.js:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
SESSION_SECRET=CHANGEME_GENERATE_SECURE_SECRET_MIN_32_HEX_CHARS

SESSION_COOKIE_NAME=temarihub_sid
SESSION_MAX_AGE_MS=604800000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Initial Admin Provisioning (Used strictly by `npm run seed:admin`, never exposed to browser)
# Requires a minimum 8-character password.
# The provisioning script will refuse to automatically escalate any existing student/submitter account.
INITIAL_ADMIN_EMAIL=admin@temarihub.et
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_MIN_8_CHAR_STRONG_PASSWORD
INITIAL_ADMIN_NAME=TemariHub Initial Administrator

# Google Account Authentication (Google Identity Services)
# Web Client ID from Google Cloud Console (Public configuration for frontend)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
# Server-side verification audience (must match frontend client ID)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Privileged Account Google Identity Configuration
# Verified Google Accounts matching these emails receive respective roles upon Google Sign-In:
ADMIN_EMAIL=petrossisay1646@gmail.com
SUBMITTER_EMAIL=petrossisay7164@gmail.com

# University Email Registration Policy (Optional Pilot Gate)
# When false, any verified Google account can register as a student.
# When true, student email domain must be in UNIVERSITY_EMAIL_DOMAINS.
REQUIRE_UNIVERSITY_EMAIL=false
# Comma-separated list of approved institutional domains (e.g. astu.edu.et,aau.edu.et,hu.edu.et)
UNIVERSITY_EMAIL_DOMAINS=astu.edu.et,aau.edu.et

# Opportunity Source Monitoring & Continuous Verification
OPPORTUNITY_MONITORING_ENABLED=true
OPPORTUNITY_MONITORING_INTERVAL_MS=3600000

