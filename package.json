{
  "name": "temarihub",
  "version": "1.0.0",
  "private": true,
  "description": "Opportunity discovery and application tracking platform for Ethiopian university students in STEM",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=client",
    "build:client": "npm run build --workspace=client",
    "test:client": "npm run test --workspace=client",
    "typecheck:client": "npm run typecheck --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build:server": "npm run build --workspace=server",
    "test:server": "npm run test --workspace=server",
    "typecheck:server": "npm run typecheck --workspace=server",
    "test": "npm run test:client && npm run test:server",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "build": "npm run build:client && npm run build:server",
    "start": "npm run start --workspace=server",
    "start:server": "npm run start --workspace=server",
    "seed:admin": "npm run seed:admin --workspace=server",
    "seed:opportunities": "npm run seed:opportunities --workspace=server"
  },
  "keywords": [
    "ethiopia",
    "stem",
    "opportunities",
    "astu",
    "internships",
    "education"
  ],
  "author": "TemariHub Team",
  "license": "MIT"
}
